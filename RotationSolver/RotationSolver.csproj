<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Description>Based on the pve combat information in one frame, find the best action.</Description>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<OutputPath>$(SolutionDir)bin\$(Configuration)\</OutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ECommons" Version="3.2.1.26" />
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="RebornMaterial" Version="7.5.7.2" />
		<PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
		<Reference Include="Dalamud.Common" Private="false" />
		<ProjectReference Include="..\RotationSolver.SourceGenerators\RotationSolver.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<AdditionalFiles Include="..\BannedSymbols.txt" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="System.ComponentModel" />
		<Using Include="Dalamud.Game.ClientState.JobGauge.Types" />
		<Using Include="Dalamud.Game.ClientState.Objects.Types" />
		<Using Include="RotationSolver.Basic" />
		<Using Include="RotationSolver.Basic.Actions" />
		<Using Include="RotationSolver.Basic.Attributes" />
		<Using Include="RotationSolver.Basic.Configuration.RotationConfig" />
		<Using Include="RotationSolver.Basic.Data" />
		<Using Include="RotationSolver.Basic.Helpers" />
		<Using Include="RotationSolver.Basic.Rotations" />
		<Using Include="RotationSolver.Basic.Rotations.Basic" />
		<Using Include="Dalamud.Game.ClientState.JobGauge.Enums" />
		<Using Include="Dalamud.Interface" />
		<Using Include="Dalamud.Bindings.ImGui" />
		<Using Include="Newtonsoft.Json" />
	</ItemGroup>

	<ItemGroup>
		<!-- Update notes. JSON, not YAML: PruneOutputDlls would strip a YAML library. -->
		<EmbeddedResource Include="Changelog\changelog.json" LogicalName="RotationSolver.Changelog.changelog.json" />
		<EmbeddedResource Include="Changelog\credits.json" LogicalName="RotationSolver.Changelog.credits.json" />
		<EmbeddedResource Include="Changelog\banner.jpg" LogicalName="RotationSolver.Changelog.banner.jpg" />
		<EmbeddedResource Include="..\Images\Logo.png" Link="Images\Logo.png" LogicalName="RotationSolver.Images.Logo.png" />
	</ItemGroup>

	<Target Name="PruneOutputDlls" AfterTargets="ResolveReferences">
		<ItemGroup>
			<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' != 'ECommons' and '%(Filename)' != 'RebornMaterial'" />
		</ItemGroup>
	</Target>
</Project>